#!/usr/bin/env bash
# env.sh — project environment variables
# Source this from any script: . /root/claw/scripts/env.sh

export ANTHROPIC_API_KEY=YOUR_KEY_HERE
export DISCORD_WEBHOOK_URL="YOUR_DISCORD_WEBHOOK_URL_HERE"
export DISCORD_WEBHOOK_AWARDS="YOUR_DISCORD_WEBHOOK_AWARDS_HERE"
export DISCORD_WEBHOOK_PORTFOLIO="YOUR_DISCORD_WEBHOOK_PORTFOLIO_HERE"

# Orchestrator Discord bot (required for claw-orchestrator-bot.service)
# 1. Create a bot at https://discord.com/developers/applications
# 2. Enable "Message Content Intent" under Bot → Privileged Gateway Intents
# 3. Invite with scopes: bot + permissions: Send Messages, Read Message History
export DISCORD_BOT_TOKEN=""
# Right-click #general → Copy Channel ID (enable Developer Mode in Discord settings first)
export DISCORD_GENERAL_CHANNEL_ID="YOUR_CHANNEL_ID_HERE"
export DISCORD_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"

# OpenRouter — for multi-model Project B tier runs
# Add your key: https://openrouter.ai/keys
export OPENROUTER_API_KEY="YOUR_KEY_HERE"

